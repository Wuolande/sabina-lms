# ---- Site ----
NEXT_PUBLIC_APP_URL=https://sabina.education

# ---- Payload (backend + admin at /admin) ----
# Supabase Postgres. Production (Vercel): Supabase › Connect › Transaction pooler (port 6543).
# Payload keeps its tables in its own "payload" schema.
DATABASE_URI=
# Optional: Supabase CA certificate (PEM) to verify the database server.
DATABASE_CA_CERT=
# Long random string that signs sessions: `openssl rand -hex 32`
PAYLOAD_SECRET=

# ---- Cloudflare R2 (all uploaded files) ----
# Cloudflare dashboard › R2 › Manage API tokens (Object Read & Write on the buckets below).
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
# Public bucket (avatars, blog/page images, course thumbnails) and its public address
# (custom domain like https://files.sabina.education, or the bucket's r2.dev URL).
R2_BUCKET=sabina-public
R2_PUBLIC_URL=
# Private bucket (tutor ID documents, certificates, lesson materials) - phase 2.
R2_PRIVATE_BUCKET=sabina-private
# Only if you use a non-default endpoint (e.g. EU jurisdiction): https://<account>.eu.r2.cloudflarestorage.com
R2_ENDPOINT=

# ---- Cloudflare Stream (video) - phase 5/7 ----
CLOUDFLARE_STREAM_ACCOUNT_ID=
CLOUDFLARE_STREAM_API_TOKEN=
CLOUDFLARE_STREAM_CUSTOMER_CODE=
CLOUDFLARE_STREAM_SIGNING_KEY_ID=
CLOUDFLARE_STREAM_SIGNING_KEY_PEM=

# ---- Email (Payload's email adapter) ----
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
EMAIL_FROM=no-reply@sabina.education
EMAIL_FROM_NAME=Sabina Education

# ---- Live classroom ----
NEXT_PUBLIC_LIVEKIT_URL=
LIVEKIT_API_KEY=
LIVEKIT_API_SECRET=

# ---- Legacy (removed in phase 8) ----
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# ── Payments (phase 4) ────────────────────────────────────────────────
# Each provider is switched on by its secret key. Without any key, a "Test payment" option is
# offered outside production so bookings can be tried end to end (PAYMENTS_DEV_MODE=on forces it).
# Stripe (cards, Apple/Google Pay). Webhook: https://<site>/api/payments/webhook/stripe
#   events: checkout.session.completed, checkout.session.async_payment_succeeded/failed, checkout.session.expired
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
# Paystack (M-Pesa, mobile money, African cards). Webhook: https://<site>/api/payments/webhook/paystack
PAYSTACK_SECRET_KEY=
PAYMENTS_DEV_MODE=

# Scheduled housekeeping (/api/cron/housekeeping): expires holds, settles attendance, sends
# lesson reminders. Vercel Cron sends "Authorization: Bearer $CRON_SECRET" automatically.
CRON_SECRET=
